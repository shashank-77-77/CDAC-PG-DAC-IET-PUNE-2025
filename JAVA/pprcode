package com.movieapp.service;

import com.movieapp.bean.*;
import com.movieapp.dao.MovieDao;
import com.movieapp.dao.MovieDaoImpl;

public class MovieServiceImpl implements MovieService {

    private MovieDao movieDao = new MovieDaoImpl();

    @Override
    public void addMovie(Movie movie) {
        if (movieDao.addMovie(movie))
            System.out.println("Movie added successfully.");
        else
            System.out.println("Duplicate Movie ID. Add operation rejected.");
    }

    @Override
    public void deleteMovie(int movieId) {
        if (movieDao.deleteMovie(movieId))
            System.out.println("Movie deleted successfully.");
        else
            System.out.println("Movie ID not found.");
    }

    @Override
    public void displayMovieByType(int type) {
        for (Movie m : movieDao.getAllMovies()) {
            if (type == 1 && m instanceof ShortMovie)
                m.display();
            else if (type == 2 && m instanceof BollywoodMovie)
                m.display();
        }
    }
}


