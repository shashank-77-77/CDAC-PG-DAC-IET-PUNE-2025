package com.movieapp.test;

import com.movieapp.bean.*;
import com.movieapp.service.*;

import java.time.LocalDate;
import java.util.Scanner;

public class MovieTest {

    public static void main(String[] args) {

        MovieService service = new MovieServiceImpl();
        Scanner sc = new Scanner(System.in);
        int choice;

        do {
            System.out.println("\n1.Add Movie\n2.Delete Movie\n3.Display By Type\n4.Exit");
            choice = sc.nextInt();

            switch (choice) {

                case 1:
                    System.out.print("Movie ID: ");
                    int id = sc.nextInt();
                    sc.nextLine();

                    System.out.print("Name: ");
                    String name = sc.nextLine();

                    System.out.print("Actor: ");
                    String actor = sc.nextLine();

                    System.out.print("Actress: ");
                    String actress = sc.nextLine();

                    System.out.println("Type: 1.Short 2.Bollywood");
                    int type = sc.nextInt();

                    if (type == 1) {
                        System.out.print("Duration: ");
                        int dur = sc.nextInt();
                        sc.nextLine();
                        System.out.print("Topic: ");
                        String topic = sc.nextLine();

                        service.addMovie(new ShortMovie(
                                id, name, actor, actress,
                                LocalDate.now(), dur, topic));

                    } else {
                        System.out.print("Songs Count: ");
                        int songs = sc.nextInt();
                        sc.nextLine();
                        System.out.print("Singer: ");
                        String singer = sc.nextLine();

                        service.addMovie(new BollywoodMovie(
                                id, name, actor, actress,
                                LocalDate.now(), songs, singer));
                    }
                    break;

                case 2:
                    System.out.print("Enter Movie ID: ");
                    service.deleteMovie(sc.nextInt());
                    break;

                case 3:
                    System.out.println("1.Short 2.Bollywood");
                    service.displayMovieByType(sc.nextInt());
                    break;

                case 4:
                    System.out.println("System shutdown completed.");
            }
        } while (choice != 4);
    }
}


